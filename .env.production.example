# --- PRODUCTION TEMPLATE ---
# Copy this file to .env on the VPS, then replace all placeholder values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
GRAFANA_USER=YOUR_GRAFANA_USER
GRAFANA_PASSWORD=YOUR_GRAFANA_PASSWORD

NGINX_HTTPS_BIND=0.0.0.0:443
GRAFANA_CSRF_TRUSTED_ORIGINS=https://YOUR_VPS_PUBLIC_IP
GRAFANA_ROOT_URL=https://YOUR_VPS_PUBLIC_IP/grafana/
CERT_SUBJECT_ALT_NAME=DNS:localhost,IP:127.0.0.1,IP:YOUR_VPS_PUBLIC_IP

# --- Monitoring settings ---
PROMETHEUS_RETENTION_TIME=15d
MONITORING_METRICS_REFRESH_SECONDS=30
MONITORING_DISCONNECT_MINUTES=15

# --- Ingestion broker mode ---
INGESTION_MODE=broker
BROKER_PROVIDER=redis
BROKER_QUEUE_NAME=telemetry.ingestion
BROKER_CONSUMER_ENABLED_API=false
BROKER_CONSUMER_ENABLED_WORKER=true
BROKER_PREFETCH_COUNT=100
BROKER_BATCH_SIZE=100
BROKER_FLUSH_SECONDS=1.0

# --- Redis Streams adapter settings (used when BROKER_PROVIDER=redis) ---
REDIS_URL=redis://redis:6379/0
REDIS_CONSUMER_GROUP=telemetry-ingestion-group
REDIS_CONSUMER_NAME_API=telemetry-ingestion-api
REDIS_CONSUMER_NAME_WORKER=telemetry-ingestion-worker-{hostname}-{pid}
REDIS_POLL_TIMEOUT_MS=1000
