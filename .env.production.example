# --- PRODUCTION TEMPLATE ---
GRAFANA_CSRF_TRUSTED_ORIGINS=$IP # (OPTIONAL / ALREADY DEFINED IN COMPOSE)
GRAFANA_ROOT_URL=https://$IP/grafana/ # (OPTIONAL / ALREADY DEFINED IN COMPOSE)
GRAFANA_USER=CHANGE_ME
GRAFANA_PASSWORD=CHANGE_ME!

NGINX_HTTPS_BIND=0.0.0.0:443 # (OPTIONAL / ALREADY DEFINED IN COMPOSE)
CERT_SUBJECT_ALT_NAME=DNS:localhost,IP:127.0.0.1,IP:$IP # (OPTIONAL / ALREADY DEFINED IN COMPOSE)
DATABASE_URL=$URL
API_BEARER_TOKEN=TOKEN_CHANGE_ME # (HTTPS REQUIRED / JUST RUN `openssl rand -hex 32` TO GENERATE A SECURE TOKEN AND UPDATE THIS VALUE)

# --- Monitoring settings ---
PROMETHEUS_RETENTION_TIME=15d # (OPTIONAL / ALREADY DEFINED IN COMPOSE)
MONITORING_METRICS_REFRESH_SECONDS=30 # (OPTIONAL / ALREADY DEFINED IN COMPOSE)
MONITORING_DISCONNECT_MINUTES=15 # (OPTIONAL / ALREADY DEFINED IN COMPOSE)

# --- Ingestion broker mode ---
INGESTION_MODE=broker
BROKER_PROVIDER=redis
BROKER_QUEUE_NAME=telemetry.ingestion
BROKER_CONSUMER_ENABLED_API=false
BROKER_CONSUMER_ENABLED_WORKER=true
BROKER_PREFETCH_COUNT=100
BROKER_BATCH_SIZE=100
BROKER_FLUSH_SECONDS=1.0

# --- Redis Streams adapter settings (used when BROKER_PROVIDER=redis) ---
REDIS_URL=redis://redis:6379/0
REDIS_CONSUMER_GROUP=telemetry-ingestion-group
REDIS_CONSUMER_NAME=telemetry-ingestion-api
REDIS_CONSUMER_NAME_WORKER=telemetry-ingestion-worker-{hostname}-{pid}
REDIS_POLL_TIMEOUT_MS=1000

# -- MySQL source for legacy ingestion
MYSQL_HOST=$IP
MYSQL_PORT=3306
MYSQL_USER=$USER
MYSQL_PASSWORD=$PASS
MYSQL_DATABASE=$DB_NAME
MYSQL_CHECKPOINT_PATH=/var/lib/mysql-sync/checkpoint.json