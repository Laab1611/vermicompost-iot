        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "clamp_min(3 - (((3 - count(up{job=~\"telemetry-ingestion-service|query-monitoring-service|digital-twin-integration-service\"}) or vector(3)) >= bool 1) + ((histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=~\"telemetry-ingestion-service|query-monitoring-service|digital-twin-integration-service\",handler!~\"/health|/metrics\"}[$__rate_interval]))) * 1000 or vector(0)) >= bool 5000) + ((histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=~\"telemetry-ingestion-service|query-monitoring-service|digital-twin-integration-service\",handler!~\"/health|/metrics\"}[$__rate_interval]))) * 1000 or vector(0)) >= bool 3000) + ((100 * (sum(rate(http_requests_total{job=~\"telemetry-ingestion-service|query-monitoring-service|digital-twin-integration-service\",status=~\"5..\",handler!~\"/health|/metrics\"}[$__rate_interval])) or vector(0)) / clamp_min((sum(rate(http_requests_total{job=~\"telemetry-ingestion-service|query-monitoring-service|digital-twin-integration-service\",handler!~\"/health|/metrics\"}[$__rate_interval])) or vector(0)), 0.001)) >= bool 1)), 1)",
          "legendFormat": "Estado",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 2 },
              { "color": "green", "value": 3 }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": { "text": "CRITICO", "color": "red" },
                "2": { "text": "DEGRADADO", "color": "orange" },
                "3": { "text": "SANO", "color": "green" }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
