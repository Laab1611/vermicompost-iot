{
  "id": null,
  "uid": "vermicompost-sensores-cama",
  "title": "Vermicompost IoT - Sensores Por Cama",
  "tags": ["vermicompost", "dominio", "sensores", "camas"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "cama_id",
        "label": "Cama",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(query_cama_info{ubicacion=~\".+\"}, cama_id)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total camas",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "count(count by (cama_id) (query_cama_info{cama_id=~\"${cama_id:regex}\"})) or vector(0)",
          "legendFormat": "Camas",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 0 },
        "overrides": []
      },
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Nodos conectados",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "count(count by (nodo_id) (query_monitoring_nodo_conectado{cama_id=~\"${cama_id:regex}\"} == 1)) or vector(0)",
          "legendFormat": "Conectados",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 0 },
        "overrides": []
      },
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Nodos desconectados",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "count(count by (nodo_id) (query_monitoring_nodo_conectado{cama_id=~\"${cama_id:regex}\"} == 0)) or vector(0)",
          "legendFormat": "Desconectados",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": 0, "color": "green" },
              { "value": 1, "color": "orange" },
              { "value": 5, "color": "red" }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Lecturas inválidas",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(query_monitoring_errores_por_nodo_total{cama_id=~\"${cama_id:regex}\"}) or vector(0)",
          "legendFormat": "Inválidas",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": 0, "color": "green" },
              { "value": 1, "color": "orange" }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Detalle de camas registradas",
      "description": "Lista todas las camas registradas con su cantidad de sensores.",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "query-api" },
      "targets": [
        {
          "refId": "A",
          "source": "url",
          "format": "table",
          "url": "http://prometheus:9090/api/v1/query?query=query_cama_info",
          "method": "GET",
          "data": "",
          "root_selector": "$.data.result[*].metric",
          "columns": [
            { "selector": "cama_id", "text": "cama_id", "type": "string" },
            { "selector": "cama_nombre", "text": "cama_nombre", "type": "string" },
            { "selector": "ubicacion", "text": "ubicacion", "type": "string" }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "center" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "ID" },
            "properties": [
              { "id": "custom.width", "value": 40 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Nombre" },
            "properties": [
              { "id": "custom.width", "value": 180 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Ubicación" },
            "properties": [
              { "id": "custom.width", "value": 360 }
            ]
          }
        ]
      },
      "options": { "showHeader": true },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "cama_id": 0,
              "cama_nombre": 1,
              "ubicacion": 2
            },
            "renameByName": {
              "cama_id": "ID",
              "cama_nombre": "Nombre",
              "ubicacion": "Ubicación"
            }
          }
        },
        {
          "id": "filterByValue",
          "options": {
            "filters": [
              {
                "fieldName": "ID",
                "config": {
                  "id": "regex",
                  "options": { "value": "${cama_id:regex}" }
                }
              }
            ],
            "type": "include",
            "match": "any"
          }
        }
      ],
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 5 }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Lecturas faltantes por cama",
      "description": "Muestra cada variable que todavía no tiene una serie de sensor emitida para una cama registrada.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (cama_id, cama_nombre, ubicacion, variable) (label_replace(query_cama_info{ubicacion=~\".+\", cama_id=~\"${cama_id:regex}\"} unless on(cama_id,cama_nombre) query_sensor_temperatura_celsius, \"variable\", \"Temperatura\", \"cama_id\", \".*\") or label_replace(query_cama_info{ubicacion=~\".+\", cama_id=~\"${cama_id:regex}\"} unless on(cama_id,cama_nombre) query_sensor_humedad_relativa_percent, \"variable\", \"Humedad relativa\", \"cama_id\", \".*\") or label_replace(query_cama_info{ubicacion=~\".+\", cama_id=~\"${cama_id:regex}\"} unless on(cama_id,cama_nombre) query_sensor_ph, \"variable\", \"pH\", \"cama_id\", \".*\"))",
          "format": "table",
          "instant": true,
          "legendFormat": "{{cama_nombre}} (cama {{cama_id}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 0, "custom": { "align": "center" } },
"overrides": [
          {
            "matcher": { "id": "byName", "options": "ID" },
            "properties": [
              { "id": "custom.width", "value": 50 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Nombre" },
            "properties": [
              { "id": "custom.width", "value": 150 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Ubicación" },
            "properties": [
              { "id": "custom.width", "value": 220 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Variable" },
            "properties": [
              { "id": "custom.width", "value": 130 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Variable" },
            "properties": [
              { "id": "custom.width", "value": 130 }
            ]
          }
        ]
      },
      "options": { "showHeader": true },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": ["cama_id", "cama_nombre", "ubicacion", "variable"]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "cama_id": 0,
              "cama_nombre": 1,
              "ubicacion": 2,
              "variable": 3
            },
            "renameByName": {
              "cama_id": "ID",
              "cama_nombre": "Nombre",
              "ubicacion": "Ubicación",
              "variable": "Variable"
            }
          }
        }
      ],
      "gridPos": { "x": 8, "y": 10, "w": 8, "h": 5 }
    },
    {
      "id": 18,
      "type": "table",
      "title": "Estado de variables por cama",
      "description": "Disponibilidad de variables de sensor por cama. Verde: datos presentes en Prometheus. Rojo: sin datos registrados.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "label_replace(\n  (count by (cama_id, cama_nombre) (query_sensor_temperatura_celsius{cama_id=~\"${cama_id:regex}\"}) * 0 + 1)\n  or\n  (count by (cama_id, cama_nombre) (query_cama_info{cama_id=~\"${cama_id:regex}\"}) * 0),\n  \"variable\", \"Temperatura\", \"cama_id\", \".*\"\n)\nor\nlabel_replace(\n  (count by (cama_id, cama_nombre) (query_sensor_humedad_relativa_percent{cama_id=~\"${cama_id:regex}\"}) * 0 + 1)\n  or\n  (count by (cama_id, cama_nombre) (query_cama_info{cama_id=~\"${cama_id:regex}\"}) * 0),\n  \"variable\", \"Humedad relativa\", \"cama_id\", \".*\"\n)\nor\nlabel_replace(\n  (count by (cama_id, cama_nombre) (query_sensor_ph{cama_id=~\"${cama_id:regex}\"}) * 0 + 1)\n  or\n  (count by (cama_id, cama_nombre) (query_cama_info{cama_id=~\"${cama_id:regex}\"}) * 0),\n  \"variable\", \"pH\", \"cama_id\", \".*\"\n)",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "center" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [
              { "id": "custom.width", "value": 100 },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": { "text": "Disponible", "color": "green" },
                      "0": { "text": "Faltante", "color": "red" }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "cama_id" },
            "properties": [
              { "id": "custom.width", "value": 40 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "cama_nombre" },
            "properties": [
              { "id": "custom.width", "value": 200 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "variable" },
            "properties": [
              { "id": "custom.width", "value": 140 }
            ]
          }
        ]
      },
      "options": { "showHeader": true },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              { "field": "cama_id", "desc": false }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "cama_id": 0,
              "cama_nombre": 1,
              "variable": 2,
              "Value": 3
            },
            "renameByName": {
              "cama_id": "Cama",
              "cama_nombre": "Nombre",
              "variable": "Variable",
              "Value": "Estado"
            }
          }
        }
      ],
      "gridPos": { "x": 16, "y": 10, "w": 8, "h": 5 }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Temperatura por cama (°C)",
