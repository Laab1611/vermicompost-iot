    {
      "id": 13,
      "type": "table",
      "title": "Sensores desconectados",
      "description": "Nodos que no han reportado lecturas recientemente, según la ventana de monitoreo del backend. Obtenidos desde la API del servicio de monitoreo.",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "query-api" },
      "targets": [
        {
          "refId": "A",
          "source": "url",
          "format": "table",
          "url": "http://query-monitoring-service:8000/api/v1/nodos/desconectados",
          "method": "GET",
          "data": "",
          "root_selector": "",
          "columns": [
            { "selector": "nodo_id", "text": "ID", "type": "number" },
            { "selector": "codigo_nodo", "text": "Código", "type": "string" },
            { "selector": "cama_id", "text": "Cama", "type": "string" },
            { "selector": "ultima_lectura_recibida", "text": "Última Lectura", "type": "string" }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "center" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "ID" },
            "properties": [
              { "id": "custom.width", "value": 40 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Código" },
            "properties": [
              { "id": "custom.width", "value": 180 }
            ]
          },
          {
