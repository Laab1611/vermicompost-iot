      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 5 }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Tasa de error broker (%)",
      "description": "Porcentaje de mensajes procesados con error respecto al total procesado.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * ((sum(rate(ingestion_broker_processed_total{status=\"error\"}[$__rate_interval])) or vector(0)) / clamp_min((sum(rate(ingestion_broker_processed_total[$__rate_interval])) or vector(0)), 0.001))",
          "legendFormat": "Tasa error",
          "refId": "A"
