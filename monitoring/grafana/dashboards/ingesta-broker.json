          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(ingestion_broker_enqueue_total[$__rate_interval])) or vector(0)",
          "legendFormat": "Encolados",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops", "decimals": 2 },
        "overrides": []
