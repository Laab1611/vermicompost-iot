{
  "id": null,
  "uid": "vermicompost-ingesta-broker",
  "title": "Vermicompost IoT - Pipeline de Ingesta (Redis Streams)",
  "tags": ["vermicompost", "backend", "ingesta", "broker", "redis"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 10,
      "type": "stat",
      "title": "Estado del Broker",
      "description": "3 = SANO, 2 = DEGRADADO (errores/lag/pendientes elevados), 1 = CRITICO (multiples condiciones adversas).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "clamp_min(3 - (((sum(rate(ingestion_broker_processed_total{status=\"error\"}[$__rate_interval])) or vector(0)) > bool 0) + ((max(ingestion_redis_consumer_lag) or vector(0)) >= bool 250) + ((max(ingestion_redis_consumer_lag) or vector(0)) >= bool 500) + ((max(ingestion_redis_pending_messages) or vector(0)) >= bool 100) + ((max(ingestion_redis_pending_messages) or vector(0)) >= bool 250) + ((((histogram_quantile(0.95, sum by (le) (rate(ingestion_broker_process_seconds_bucket[$__rate_interval]))) * 1000) and on() (sum(rate(ingestion_broker_process_seconds_count[$__rate_interval])) > 0)) or vector(0)) >= bool 1000) + ((((histogram_quantile(0.95, sum by (le) (rate(ingestion_broker_process_seconds_bucket[$__rate_interval]))) * 1000) and on() (sum(rate(ingestion_broker_process_seconds_count[$__rate_interval])) > 0)) or vector(0)) >= bool 2000)), 1)",
          "legendFormat": "Salud",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 2 },
              { "color": "green", "value": 3 }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": { "text": "CRÍTICO", "color": "red" },
                "2": { "text": "DEGRADADO", "color": "orange" },
                "3": { "text": "SANO", "color": "green" }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Mensajes encolados (msg/s)",
