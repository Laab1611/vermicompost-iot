{
  "id": null,
  "uid": "vermicompost-estado-general",
  "title": "Vermicompost IoT - Estado General",
  "tags": ["vermicompost", "sistema", "overview"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Servicios disponibles",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(up{job=~\"telemetry-ingestion-service|query-monitoring-service|digital-twin-integration-service|prometheus|grafana\"})",
          "legendFormat": "Servicios UP",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": 0, "color": "red" },
              { "value": 4, "color": "orange" },
              { "value": 5, "color": "green" }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Camas registradas",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(query_monitoring_total_camas) or vector(0)",
          "legendFormat": "Camas",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 0 },
        "overrides": []
      },
      "gridPos": { "x": 6, "y": 0, "w": 5, "h": 5 }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Nodos registrados",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(query_monitoring_total_nodos) or vector(0)",
          "legendFormat": "Nodos",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 0 },
        "overrides": []
      },
      "gridPos": { "x": 11, "y": 0, "w": 5, "h": 5 }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Nodos desconectados",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
