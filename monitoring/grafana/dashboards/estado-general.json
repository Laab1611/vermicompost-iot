      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": 0, "color": "green" },
              { "value": 1, "color": "orange" },
              { "value": 5, "color": "red" }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 5 }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Lecturas inválidas",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
