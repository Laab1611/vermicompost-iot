{
  "id": null,
  "uid": "vermicompost-api-slo",
  "title": "Vermicompost IoT - API Y SLO",
  "tags": ["vermicompost", "backend", "api", "slo"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Tráfico API observado (req/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(http_requests_total{job=~\"telemetry-ingestion-service|query-monitoring-service|digital-twin-integration-service\"}[5m])) or vector(0)",
          "legendFormat": "Req/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "decimals": 2 },
        "overrides": []
      },
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error rate 5xx global (%)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * (sum(rate(http_requests_total{job=~\"telemetry-ingestion-service|query-monitoring-service|digital-twin-integration-service\",status=~\"5..\"}[5m])) or vector(0)) / clamp_min((sum(rate(http_requests_total{job=~\"telemetry-ingestion-service|query-monitoring-service|digital-twin-integration-service\"}[5m])) or vector(0)), 0.001)",
          "legendFormat": "5xx",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": 0, "color": "green" },
              { "value": 0.5, "color": "orange" },
              { "value": 1, "color": "red" }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 5 }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Latencia p95 observada (ms)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=~\"telemetry-ingestion-service|query-monitoring-service|digital-twin-integration-service\"}[5m]))) * 1000 or vector(0)",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": 0, "color": "green" },
              { "value": 3000, "color": "orange" },
              { "value": 5000, "color": "red" }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 5 }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Servicios backend UP",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(up{job=~\"telemetry-ingestion-service|query-monitoring-service|digital-twin-integration-service\"})",
          "legendFormat": "Backend UP",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": 0, "color": "red" },
              { "value": 2, "color": "orange" },
              { "value": 3, "color": "green" }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 5 }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Throughput por servicio (req/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (job) (rate(http_requests_total{job=~\"telemetry-ingestion-service|query-monitoring-service|digital-twin-integration-service\"}[5m])) or sum by (job) (0 * up{job=~\"telemetry-ingestion-service|query-monitoring-service|digital-twin-integration-service\"})",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "decimals": 2 },
        "overrides": []
      },
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latencia p95 por servicio (ms, todo tráfico)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, job) (rate(http_request_duration_seconds_bucket{job=~\"telemetry-ingestion-service|query-monitoring-service|digital-twin-integration-service\"}[5m]))) * 1000 or sum by (job) (0 * up{job=~\"telemetry-ingestion-service|query-monitoring-service|digital-twin-integration-service\"})",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": 0, "color": "green" },
              { "value": 3000, "color": "orange" },
              { "value": 5000, "color": "red" }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Error rate 5xx por servicio (%)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * (sum by (job) (rate(http_requests_total{job=~\"telemetry-ingestion-service|query-monitoring-service|digital-twin-integration-service\",status=~\"5..\"}[5m])) or sum by (job) (0 * up{job=~\"telemetry-ingestion-service|query-monitoring-service|digital-twin-integration-service\"})) / clamp_min((sum by (job) (rate(http_requests_total{job=~\"telemetry-ingestion-service|query-monitoring-service|digital-twin-integration-service\"}[5m])) or sum by (job) (0 * up{job=~\"telemetry-ingestion-service|query-monitoring-service|digital-twin-integration-service\"})), 0.001)",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": 0, "color": "green" },
              { "value": 0.5, "color": "orange" },
              { "value": 1, "color": "red" }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Latencia p95 por servicio (ms, solo tráfico de aplicación)",
      "description": "Excluye /health y /metrics. En un stack limpio puede no mostrar series hasta que haya tráfico funcional.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, job) (rate(http_request_duration_seconds_bucket{job=~\"telemetry-ingestion-service|query-monitoring-service|digital-twin-integration-service\",handler!~\"/health|/metrics\"}[5m]))) * 1000",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": 0, "color": "green" },
              { "value": 3000, "color": "orange" },
              { "value": 5000, "color": "red" }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 8 }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Tráfico por handler (solo aplicación)",
      "description": "Excluye /health y /metrics para separar actividad funcional de scrapes y healthchecks.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (job, handler) (rate(http_requests_total{job=~\"telemetry-ingestion-service|query-monitoring-service|digital-twin-integration-service\",handler!~\"/health|/metrics\"}[5m]))",
          "legendFormat": "{{job}} {{handler}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "decimals": 2 },
        "overrides": []
      },
      "gridPos": { "x": 0, "y": 21, "w": 24, "h": 8 }
    }
  ],
  "templating": { "list": [] },
  "annotations": {
    "list": [
      { "name": "Eventos", "type": "dashboard", "builtIn": 1, "enable": true }
    ]
  }
}
