{
  "id": null,
  "uid": "vermicompost-plataforma",
  "title": "Vermicompost IoT - Plataforma",
  "tags": ["vermicompost", "plataforma", "prometheus", "grafana"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Targets UP",
      "description": "Targets de scrape que responden correctamente (5: 3 microservicios + Prometheus + Grafana).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(up{job=~\"telemetry-ingestion-service|query-monitoring-service|digital-twin-integration-service|prometheus|grafana\"})",
          "legendFormat": "UP",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": 0, "color": "red" },
              { "value": 4, "color": "orange" },
              { "value": 5, "color": "green" }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "x": 0, "y": 0, "w": 5, "h": 5 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Scrapes fallidos",
      "description": "Targets de scrape que no responden (up=0). Corresponde al complemento de Targets UP.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(up{job=~\"telemetry-ingestion-service|query-monitoring-service|digital-twin-integration-service|prometheus|grafana\"} == bool 0) or vector(0)",
          "legendFormat": "Down",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1, "color": "red" }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "x": 5, "y": 0, "w": 4, "h": 5 }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Config Prometheus OK",
      "description": "Indica si la ultima recarga de configuracion de Prometheus fue exitosa.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(prometheus_config_last_reload_successful) or vector(0)",
          "legendFormat": "Reload",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": { "text": "OK" },
                "0": { "text": "FAIL" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 1, "color": "green" }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "x": 9, "y": 0, "w": 5, "h": 5 }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Series activas TSDB",
      "description": "Numero de series de tiempo activas en el TSDB de Prometheus. Indicador de cardinalidad de metricas.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "avg(prometheus_tsdb_head_series) or vector(0)",
          "legendFormat": "Series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 10000, "color": "orange" },
              { "value": 50000, "color": "red" }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "x": 14, "y": 0, "w": 5, "h": 5 }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Ingesta TSDB (samples/s)",
      "description": "Tasa de samples agregados al TSDB. Indica carga de escritura en Prometheus.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "avg(rate(prometheus_tsdb_head_samples_appended_total{type!=\"histogram\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "samples/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1
        },
        "overrides": []
      },
      "gridPos": { "x": 19, "y": 0, "w": 5, "h": 5 }
    },
    {
      "id": 6,
      "type": "status-history",
      "title": "Historial de scrape por target",
      "description": "Estado de cada target monitoreado (UP=verde, DOWN=rojo) en el tiempo. Cada fila representa un job de scrape.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "up{job=~\"telemetry-ingestion-service|query-monitoring-service|digital-twin-integration-service|prometheus|grafana\"}",
          "legendFormat": "{{job}}",
          "interval": "5m",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": { "text": "UP" },
                "0": { "text": "DOWN" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 1, "color": "green" }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colWidth": 0.7,
        "rowHeight": 0.6,
        "showValue": "never",
        "mergeValues": true,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Duracion de scrape (ms)",
      "description": "Tiempo que tarda Prometheus en recolectar metricas de cada target.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "scrape_duration_seconds{job=~\"telemetry-ingestion-service|query-monitoring-service|digital-twin-integration-service|prometheus|grafana\"} * 1000",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": ["last", "max", "mean"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 }
    },
    {
      "id": 8,
