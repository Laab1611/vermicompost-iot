      "title": "Fallos eval.",
      "description": "Fallos de evaluacion de reglas de alerta en Prometheus en la ventana de tiempo.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(prometheus_rule_evaluation_failures_total[$__rate_interval])) or vector(0)",
          "legendFormat": "Fallos",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
