            "steps": [
              { "value": null, "color": "green" },
              { "value": 1, "color": "red" }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 5 }
    },
    {
      "id": 7,
      "type": "piechart",
      "title": "Firing por severidad",
      "description": "Distribucion de alertas firing agrupadas por severidad (critical vs warning).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "count by (severity) (ALERTS{alertstate=\"firing\"})",
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "critical" },
            "properties": [
              { "id": "color", "value": { "fixed": "red", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "warning" },
            "properties": [
              { "id": "color", "value": { "fixed": "orange", "mode": "fixed" } }
            ]
          }
        ]
      },
      "options": {
        "pieType": "pie",
        "displayLabels": ["name", "value", "percent"],
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "gridPos": { "x": 0, "y": 5, "w": 6, "h": 6 }
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "Estado Grafana Alerting",
      "description": "Alertas gestionadas por Grafana Alerting agrupadas por estado (alerting, normal, pending, etc.).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "grafana_alerting_alerts",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1, "color": "red" }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "normal" },
            "properties": [
              { "id": "color", "value": { "fixed": "green", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "alerting" },
            "properties": [
              { "id": "color", "value": { "fixed": "red", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "pending" },
            "properties": [
              { "id": "color", "value": { "fixed": "orange", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "error" },
            "properties": [
              { "id": "color", "value": { "fixed": "dark-red", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "nodata" },
            "properties": [
              { "id": "color", "value": { "fixed": "gray", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "recovering" },
            "properties": [
              { "id": "color", "value": { "fixed": "blue", "mode": "fixed" } }
            ]
          }
        ]
      },
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "showUnfilled": true
      },
      "gridPos": { "x": 6, "y": 5, "w": 6, "h": 6 }
    },
