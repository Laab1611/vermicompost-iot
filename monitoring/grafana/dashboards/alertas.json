    {
      "id": 12,
      "type": "status-history",
      "title": "Historial de alertas",
      "description": "Alertas firing en el tiempo. Cada fila representa una alerta activa. Verde=activa (firing), rojo=inactiva (OK).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "ALERTS{alertstate=\"firing\"}",
          "legendFormat": "{{alertname}} / {{cama_nombre}} / {{job}}",
          "interval": "5m",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": { "text": "FIRING" },
                "0": { "text": "OK" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 1, "color": "green" }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colWidth": 0.7,
        "rowHeight": 0.6,
        "showValue": "never",
        "mergeValues": true,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "gridPos": { "x": 0, "y": 18, "w": 12, "h": 8 }
    },
