{
  "id": null,
  "uid": "vermicompost-alertas",
  "title": "Vermicompost IoT - Alertas",
  "tags": ["vermicompost", "alertas", "monitoreo"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Estado de alertas",
      "description": "Estado global basado en alertas firing criticas, advertencias y fallos de evaluacion de reglas. 3=SANO, 2=ATENCION, 1=CRITICO.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "clamp_min(3 - (((count(ALERTS{alertstate=\"firing\",severity=\"critical\"}) or vector(0)) >= bool 1) + ((count(ALERTS{alertstate=\"firing\",severity=\"warning\"}) or vector(0)) >= bool 1) + ((sum(increase(prometheus_rule_evaluation_failures_total[$__rate_interval])) or vector(0)) >= bool 1)), 1)",
          "legendFormat": "Score",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 1,
          "max": 3,
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "3": { "text": "SANO" },
                "2": { "text": "ATENCION" },
                "1": { "text": "CRITICO" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 2, "color": "orange" },
              { "value": 3, "color": "green" }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 5 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Alertas firing",
      "description": "Numero de alertas en estado firing actualmente.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)",
          "legendFormat": "Firing",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1, "color": "red" }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 5 }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Criticas",
      "description": "Alertas firing con severidad critical.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "count(ALERTS{alertstate=\"firing\",severity=\"critical\"}) or vector(0)",
