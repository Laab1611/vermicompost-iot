{
  "id": null,
  "uid": "vermicompost-calidad",
  "title": "Vermicompost IoT - Calidad de Datos",
  "tags": ["vermicompost", "calidad", "datos"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Lecturas válidas",
      "description": "Total acumulado de lecturas válidas procesadas.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(query_monitoring_lecturas_validas) or vector(0)",
          "legendFormat": "Válidas",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": { "mode": "fixed" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 5 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Lecturas inválidas",
      "description": "Total acumulado de lecturas inválidas registradas.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(query_monitoring_lecturas_invalidas) or vector(0)",
          "legendFormat": "Inválidas",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": { "mode": "fixed" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 5 }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Calidad general (%)",
      "description": "Porcentaje de lecturas válidas sobre el total.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(sum(query_monitoring_lecturas_validas) / (sum(query_monitoring_lecturas_validas) + sum(query_monitoring_lecturas_invalidas)) * 100) unless (sum(query_monitoring_lecturas_validas) + sum(query_monitoring_lecturas_invalidas) == 0) or vector(100)",
          "legendFormat": "Calidad",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 90 },
              { "color": "green", "value": 99 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 5 }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Volumen de lecturas",
      "description": "Evolucion temporal del acumulado de lecturas válidas e inválidas.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(query_monitoring_lecturas_validas) or vector(0)",
          "legendFormat": "Válidas",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(query_monitoring_lecturas_invalidas) or vector(0)",
          "legendFormat": "Inválidas",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 8 }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Tasa de error en el tiempo (%)",
      "description": "Porcentaje de lecturas inválidas calculado sobre incrementos recientes dentro de la ventana seleccionada.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * ((sum(clamp_min(delta(query_monitoring_lecturas_invalidas[$__rate_interval]), 0)) or vector(0)) / clamp_min((sum(clamp_min(delta(query_monitoring_lecturas_validas[$__rate_interval]), 0)) or vector(0)) + (sum(clamp_min(delta(query_monitoring_lecturas_invalidas[$__rate_interval]), 0)) or vector(0)), 1))",
          "legendFormat": "Tasa de error",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "auto"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "gridPos": { "x": 0, "y": 13, "w": 8, "h": 8 }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Top sensores con más errores",
      "description": "Sensores con mayor cantidad de lecturas inválidas acumuladas.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "topk(10, query_monitoring_errores_por_nodo_total) or label_replace(label_replace(0 * absent(topk(10, query_monitoring_errores_por_nodo_total)), \"codigo_nodo\", \"Sin sensores\", \"__name__\", \".*\"), \"cama_nombre\", \"con errores\", \"codigo_nodo\", \".*\")",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "center" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Errores" },
            "properties": [
              { "id": "custom.width", "value": 100 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Sensor" },
            "properties": [
              { "id": "custom.width", "value": 220 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Cama" },
            "properties": [
              { "id": "custom.width", "value": 200 }
            ]
          }
        ]
      },
      "options": { "showHeader": true },
      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              { "field": "Value", "desc": true }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "cama_id": true,
              "nodo_id": true,
              "instance": true,
              "job": true
            },
            "indexByName": {
              "codigo_nodo": 0,
              "cama_nombre": 1,
              "Value": 2
            },
            "renameByName": {
              "codigo_nodo": "Sensor",
              "cama_nombre": "Cama",
              "Value": "Errores"
            }
          }
        }
      ],
      "gridPos": { "x": 8, "y": 13, "w": 8, "h": 8 }
    },
    {
      "id": 7,
      "type": "piechart",
      "title": "Distribución de errores por causa",
      "description": "Proporción de lecturas inválidas agrupadas por causa de invalidación.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "query_monitoring_invalidaciones_por_causa_total or label_replace(0 * absent(query_monitoring_invalidaciones_por_causa_total), \"tipo_error\", \"Sin invalidaciones\", \"__name__\", \".*\")",
          "legendFormat": "{{tipo_error}}",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "pieType": "donut",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "values": ["percent", "value"],
          "showLegend": true
        },
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "tooltip": {
          "mode": "single",
          "sort": "desc"
        }
      },
      "transformations": [],
      "gridPos": { "x": 16, "y": 13, "w": 8, "h": 8 }
    }
  ],
  "templating": { "list": [] },
  "annotations": {
    "list": [
      { "name": "Eventos", "type": "dashboard", "builtIn": 1, "enable": true }
    ]
  }
}