{
  "id": null,
  "uid": "vermicompost-calidad",
  "title": "Vermicompost IoT - Calidad de Datos",
  "tags": ["vermicompost", "calidad", "datos"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Lecturas válidas",
      "description": "Total acumulado de lecturas válidas procesadas.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(query_monitoring_lecturas_validas) or vector(0)",
          "legendFormat": "Válidas",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": { "mode": "fixed" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Lecturas inválidas",
      "description": "Total acumulado de lecturas inválidas registradas.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(query_monitoring_lecturas_invalidas) or vector(0)",
          "legendFormat": "Inválidas",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": { "mode": "fixed" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 5 }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Calidad general (%)",
      "description": "Porcentaje de lecturas válidas sobre el total.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(query_monitoring_lecturas_validas) / (sum(query_monitoring_lecturas_validas) + sum(query_monitoring_lecturas_invalidas)) * 100 or vector(100)",
          "legendFormat": "Calidad",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 90 },
              { "color": "green", "value": 99 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 5 }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Volumen de lecturas",
      "description": "Evolucion temporal del acumulado de lecturas válidas e inválidas.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(query_monitoring_lecturas_validas) or vector(0)",
          "legendFormat": "Válidas",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(query_monitoring_lecturas_invalidas) or vector(0)",
          "legendFormat": "Inválidas",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": ["last", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 8 }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Calidad en el tiempo",
      "description": "Evolucion del porcentaje de calidad (validas / total) en la ventana seleccionada.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(query_monitoring_lecturas_validas) / (sum(query_monitoring_lecturas_validas) + sum(query_monitoring_lecturas_invalidas)) * 100 or vector(100)",
          "legendFormat": "Calidad",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "auto"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 90 },
              { "color": "green", "value": 99 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": ["last", "max", "min"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "gridPos": { "x": 0, "y": 13, "w": 24, "h": 8 }
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Top 10 sensores con más errores",
      "description": "Sensores con mayor cantidad de lecturas inválidas acumuladas.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "topk(10, query_monitoring_errores_por_nodo_total)",
          "legendFormat": "{{codigo_nodo}} - {{cama_nombre}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "custom": {
            "orientation": "horizontal",
            "displayMode": "gradient"
          },
          "color": { "mode": "continuous-BlPu" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "gridPos": { "x": 0, "y": 21, "w": 12, "h": 8 }
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Invalidaciones por causa",
      "description": "Distribucion de causas de invalidacion de lecturas, ordenadas por frecuencia.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "query_monitoring_invalidaciones_por_causa_total",
          "legendFormat": "{{tipo_error}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "custom": {
            "orientation": "horizontal",
            "displayMode": "gradient"
          },
          "color": { "mode": "continuous-BlPu" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "gridPos": { "x": 12, "y": 21, "w": 12, "h": 8 }
    }
  ],
  "templating": { "list": [] },
  "annotations": {
    "list": [
      { "name": "Eventos", "type": "dashboard", "builtIn": 1, "enable": true }
    ]
  }
}