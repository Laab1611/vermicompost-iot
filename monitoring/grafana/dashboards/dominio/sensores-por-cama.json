{
  "id": null,
  "uid": "vermicompost-sensores-cama",
  "title": "Vermicompost IoT - Sensores Por Cama",
  "tags": ["vermicompost", "dominio", "sensores", "camas"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "cama_id",
        "label": "Cama",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(query_cama_info{ubicacion=~\".+\"}, cama_id)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": ".*"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total camas",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(query_monitoring_total_camas) or vector(0)",
          "legendFormat": "Camas",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 0 },
        "overrides": []
      },
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Nodos conectados",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(query_monitoring_nodos_conectados) or vector(0)",
          "legendFormat": "Conectados",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 0 },
        "overrides": []
      },
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 5 }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Nodos desconectados",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(query_monitoring_nodos_desconectados) or vector(0)",
          "legendFormat": "Desconectados",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": 0, "color": "green" },
              { "value": 1, "color": "orange" },
              { "value": 5, "color": "red" }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 5 }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Lecturas inválidas",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(query_monitoring_lecturas_invalidas) or vector(0)",
          "legendFormat": "Inválidas",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": 0, "color": "green" },
              { "value": 1, "color": "orange" }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 5 }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Detalle de camas registradas",
      "description": "Lista todas las camas registradas aunque todavía no tengan lecturas de sensores.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (cama_id, cama_nombre, ubicacion) (query_cama_info{ubicacion=~\".+\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "{{cama_nombre}} (cama {{cama_id}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 0 },
        "overrides": []
      },
      "options": { "showHeader": true },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": ["cama_id", "cama_nombre", "ubicacion"]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "cama_id": 0,
              "cama_nombre": 1,
              "ubicacion": 2
            },
            "renameByName": {
              "cama_id": "ID",
              "cama_nombre": "Nombre",
              "ubicacion": "Ubicación"
            }
          }
        }
      ],
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 7 }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Lecturas faltantes por cama",
      "description": "Muestra cada variable que todavía no tiene una serie de sensor emitida para una cama registrada.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (cama_id, cama_nombre, ubicacion, variable) (label_replace(query_cama_info{ubicacion=~\".+\"} unless on(cama_id,cama_nombre) query_sensor_temperatura_celsius, \"variable\", \"Temperatura\", \"cama_id\", \".*\") or label_replace(query_cama_info{ubicacion=~\".+\"} unless on(cama_id,cama_nombre) query_sensor_humedad_relativa_percent, \"variable\", \"Humedad relativa\", \"cama_id\", \".*\") or label_replace(query_cama_info{ubicacion=~\".+\"} unless on(cama_id,cama_nombre) query_sensor_ph, \"variable\", \"pH\", \"cama_id\", \".*\"))",
          "format": "table",
          "instant": true,
          "legendFormat": "{{cama_nombre}} (cama {{cama_id}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 0 },
        "overrides": []
      },
      "options": { "showHeader": true },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": ["cama_id", "cama_nombre", "ubicacion", "variable"]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "cama_id": 0,
              "cama_nombre": 1,
              "ubicacion": 2,
              "variable": 3
            },
            "renameByName": {
              "cama_id": "ID",
              "cama_nombre": "Nombre",
              "ubicacion": "Ubicación",
              "variable": "Variable"
            }
          }
        }
      ],
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 7 }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Temperatura por cama (°C)",
      "description": "Historia del gauge Prometheus de la última lectura promedio por cama. Solo incluye camas con lecturas de temperatura. No es histórico crudo de base de datos.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "query_sensor_temperatura_celsius{cama_id=~\"$cama_id\"}",
          "legendFormat": "{{cama_nombre}} (cama {{cama_id}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "celsius", "decimals": 2 },
        "overrides": []
      },
      "gridPos": { "x": 0, "y": 12, "w": 8, "h": 8 }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Humedad por cama (%)",
      "description": "Historia del gauge Prometheus de la última lectura promedio por cama. Solo incluye camas con lecturas de humedad. No es histórico crudo de base de datos.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "query_sensor_humedad_relativa_percent{cama_id=~\"$cama_id\"}",
          "legendFormat": "{{cama_nombre}} (cama {{cama_id}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "decimals": 2 },
        "overrides": []
      },
      "gridPos": { "x": 8, "y": 12, "w": 8, "h": 8 }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "pH por cama",
      "description": "Historia del gauge Prometheus de la última lectura promedio por cama. Solo incluye camas con lecturas de pH. No es histórico crudo de base de datos.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "query_sensor_ph{cama_id=~\"$cama_id\"}",
          "legendFormat": "{{cama_nombre}} (cama {{cama_id}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 2 },
        "overrides": []
      },
      "gridPos": { "x": 16, "y": 12, "w": 8, "h": 8 }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Temperatura actual por cama (°C)",
      "description": "Valor actual por cama para camas con lecturas de temperatura.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "query_sensor_temperatura_celsius{cama_id=~\"$cama_id\"}",
          "legendFormat": "{{cama_nombre}} ({{cama_id}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "celsius", "decimals": 2 },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "textMode": "auto"
      },
      "gridPos": { "x": 0, "y": 20, "w": 8, "h": 8 }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Humedad actual por cama (%)",
      "description": "Valor actual por cama para camas con lecturas de humedad.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "query_sensor_humedad_relativa_percent{cama_id=~\"$cama_id\"}",
          "legendFormat": "{{cama_nombre}} ({{cama_id}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "decimals": 2 },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "textMode": "auto"
      },
      "gridPos": { "x": 8, "y": 20, "w": 8, "h": 8 }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "pH actual por cama",
      "description": "Valor actual por cama para camas con lecturas de pH.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "query_sensor_ph{cama_id=~\"$cama_id\"}",
          "legendFormat": "{{cama_nombre}} ({{cama_id}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 2 },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "textMode": "auto"
      },
      "gridPos": { "x": 16, "y": 20, "w": 8, "h": 8 }
    }
  ],
  "annotations": {
    "list": [
      { "name": "Eventos", "type": "dashboard", "builtIn": 1, "enable": true }
    ]
  }
}
