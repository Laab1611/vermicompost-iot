{
	"id": null,
	"uid": "vermicompost-iot-full",
	"title": "Vermicompost IoT - Observabilidad Backend",
	"timezone": "browser",
	"schemaVersion": 30,
	"version": 4,
	"refresh": "30s",
	"panels": [
		{
			"type": "row",
			"title": "Estado de servicios",
			"gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
			"collapsed": false
		},
		{
			"type": "stat",
			"title": "Servicios disponibles",
			"datasource": "Prometheus",
			"targets": [
				{
					"expr": "sum(up{job=~\"telemetry-ingestion-service|query-monitoring-service|digital-twin-integration-service|prometheus|grafana\"})",
					"legendFormat": "Servicios UP",
					"refId": "A"
				}
			],
			"fieldConfig": {
				"defaults": { "unit": "none", "decimals": 0 }
			},
			"gridPos": { "x": 0, "y": 1, "w": 8, "h": 5 }
		},
		{
			"type": "stat",
			"title": "Disponibilidad media de scrape (%)",
			"datasource": "Prometheus",
			"targets": [
				{
					"expr": "100 * avg(avg_over_time(up{job=~\"telemetry-ingestion-service|query-monitoring-service|digital-twin-integration-service|prometheus|grafana\"}[5m]))",
					"legendFormat": "Disponibilidad media",
					"refId": "A"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "percent",
					"decimals": 1,
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{ "value": 0, "color": "red" },
							{ "value": 90, "color": "orange" },
							{ "value": 99, "color": "green" }
						]
					}
				}
			},
			"gridPos": { "x": 8, "y": 1, "w": 8, "h": 5 }
		},
		{
			"type": "timeseries",
			"title": "Disponibilidad por servicio (promedio 5 min)",
			"datasource": "Prometheus",
			"targets": [
				{
					"expr": "avg_over_time(up{job=~\"telemetry-ingestion-service|query-monitoring-service|digital-twin-integration-service|prometheus|grafana\"}[5m])",
					"legendFormat": "{{job}}",
					"refId": "A"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "percentunit",
					"decimals": 2,
					"min": 0,
					"max": 1
				}
			},
			"gridPos": { "x": 16, "y": 1, "w": 8, "h": 5 }
		},
		{
			"type": "row",
			"title": "Rendimiento API",
			"gridPos": { "x": 0, "y": 6, "w": 24, "h": 1 },
			"collapsed": false
		},
		{
			"type": "timeseries",
			"title": "Latencia p95 API (ms)",
			"datasource": "Prometheus",
			"targets": [
				{
					"expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"telemetry-ingestion-service\",handler!~\"/health|/metrics\"}[5m])) by (le)) * 1000",
					"refId": "A",
					"legendFormat": "Ingesta"
				},
				{
					"expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"query-monitoring-service\",handler!~\"/health|/metrics\"}[5m])) by (le)) * 1000",
					"refId": "B",
					"legendFormat": "Consulta"
				},
				{
					"expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"digital-twin-integration-service\",handler!~\"/health|/metrics\"}[5m])) by (le)) * 1000",
					"refId": "C",
					"legendFormat": "Gemelo digital"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "ms",
					"decimals": 1,
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{ "color": "green", "value": 0 },
							{ "color": "orange", "value": 3000 },
							{ "color": "red", "value": 5000 }
						]
					}
				}
			},
			"gridPos": { "x": 0, "y": 7, "w": 12, "h": 8 }
		},
		{
			"type": "timeseries",
			"title": "Error rate 5xx API (%)",
			"datasource": "Prometheus",
			"targets": [
				{
					"expr": "100 * (sum(rate(http_requests_total{job=\"telemetry-ingestion-service\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total{job=\"telemetry-ingestion-service\"}[5m])), 0.001))",
					"refId": "A",
					"legendFormat": "Ingesta"
				},
				{
					"expr": "100 * (sum(rate(http_requests_total{job=\"query-monitoring-service\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total{job=\"query-monitoring-service\"}[5m])), 0.001))",
					"refId": "B",
					"legendFormat": "Consulta"
				},
				{
					"expr": "100 * (sum(rate(http_requests_total{job=\"digital-twin-integration-service\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total{job=\"digital-twin-integration-service\"}[5m])), 0.001))",
					"refId": "C",
					"legendFormat": "Gemelo digital"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "percent",
					"decimals": 2,
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{ "color": "green", "value": 0 },
							{ "color": "orange", "value": 0.5 },
							{ "color": "red", "value": 1 }
						]
					}
				}
			},
			"gridPos": { "x": 12, "y": 7, "w": 12, "h": 8 }
		},
		{
			"type": "timeseries",
			"title": "Throughput API (req/s)",
			"datasource": "Prometheus",
			"targets": [
				{
					"expr": "sum(rate(http_requests_total{job=~\"telemetry-ingestion-service|query-monitoring-service|digital-twin-integration-service\"}[5m])) by (job)",
					"refId": "A",
					"legendFormat": "{{job}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "reqps",
					"decimals": 2
				}
			},
			"gridPos": { "x": 0, "y": 15, "w": 24, "h": 8 }
		},
		{
			"type": "row",
			"title": "Broker e ingesta",
			"gridPos": { "x": 0, "y": 23, "w": 24, "h": 1 },
			"collapsed": false
		},
		{
			"type": "timeseries",
			"title": "Mensajes encolados y procesados (msg/s)",
			"datasource": "Prometheus",
			"targets": [
				{
					"expr": "sum(rate(ingestion_broker_enqueue_total[5m]))",
					"refId": "A",
					"legendFormat": "Encolados"
				},
				{
					"expr": "sum(rate(ingestion_broker_processed_total{status=\"ok\"}[5m]))",
					"refId": "B",
					"legendFormat": "Procesados OK"
				},
				{
					"expr": "sum(rate(ingestion_broker_processed_total{status=\"error\"}[5m]))",
					"refId": "C",
					"legendFormat": "Procesados error"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "ops",
					"decimals": 2
				}
			},
			"gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 }
		},
		{
			"type": "timeseries",
			"title": "Latencia p95 de procesamiento broker (ms)",
			"datasource": "Prometheus",
			"targets": [
				{
					"expr": "histogram_quantile(0.95, sum(rate(ingestion_broker_process_seconds_bucket[5m])) by (le)) * 1000",
					"refId": "A",
					"legendFormat": "p95 broker"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "ms",
					"decimals": 1,
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{ "color": "green", "value": 0 },
							{ "color": "orange", "value": 1000 },
							{ "color": "red", "value": 2000 }
						]
					}
				}
			},
			"gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 }
		},
		{
			"type": "timeseries",
			"title": "Estado de Redis Streams y buffer (mensajes)",
			"datasource": "Prometheus",
			"targets": [
				{
					"expr": "ingestion_redis_stream_length",
					"refId": "A",
					"legendFormat": "Longitud stream"
				},
				{
					"expr": "ingestion_redis_pending_messages",
					"refId": "B",
					"legendFormat": "Pendientes"
				},
				{
					"expr": "ingestion_redis_consumer_lag",
					"refId": "C",
					"legendFormat": "Mensajes atrasados"
				},
				{
					"expr": "ingestion_batch_buffer_size",
					"refId": "D",
					"legendFormat": "Buffer batch"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "none",
					"decimals": 0
				}
			},
			"gridPos": { "x": 0, "y": 32, "w": 16, "h": 8 }
		},
		{
			"type": "stat",
			"title": "Mensajes atrasados del consumidor (Redis)",
			"datasource": "Prometheus",
			"targets": [
				{
					"expr": "ingestion_redis_consumer_lag",
					"refId": "A",
					"legendFormat": "Mensajes atrasados"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "none",
					"decimals": 0,
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{ "value": 0, "color": "green" },
							{ "value": 250, "color": "orange" },
							{ "value": 500, "color": "red" }
						]
					}
				}
			},
			"gridPos": { "x": 16, "y": 32, "w": 8, "h": 4 }
		},
		{
			"type": "stat",
			"title": "Buffer batch actual",
			"datasource": "Prometheus",
			"targets": [
				{
					"expr": "ingestion_batch_buffer_size",
					"refId": "A",
					"legendFormat": "Buffer"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "none",
					"decimals": 0,
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{ "value": 0, "color": "green" },
							{ "value": 100, "color": "orange" },
							{ "value": 250, "color": "red" }
						]
					}
				}
			},
			"gridPos": { "x": 16, "y": 36, "w": 8, "h": 4 }
		},
		{
			"type": "row",
			"title": "Sensores por cama",
			"gridPos": { "x": 0, "y": 40, "w": 24, "h": 1 },
			"collapsed": false
		},
		{
			"type": "timeseries",
			"title": "Temperatura por cama (°C)",
			"datasource": "Prometheus",
			"targets": [
				{
					"expr": "query_sensor_temperatura_celsius",
					"refId": "A",
					"legendFormat": "{{cama_nombre}} (cama {{cama_id}})"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "celsius",
					"decimals": 2
				}
			},
			"gridPos": { "x": 0, "y": 41, "w": 8, "h": 8 }
		},
		{
			"type": "timeseries",
			"title": "Humedad por cama (%)",
			"datasource": "Prometheus",
			"targets": [
				{
					"expr": "query_sensor_humedad_relativa_percent",
					"refId": "A",
					"legendFormat": "{{cama_nombre}} (cama {{cama_id}})"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "percent",
					"decimals": 2
				}
			},
			"gridPos": { "x": 8, "y": 41, "w": 8, "h": 8 }
		},
		{
			"type": "timeseries",
			"title": "pH por cama",
			"datasource": "Prometheus",
			"targets": [
				{
					"expr": "query_sensor_ph",
					"refId": "A",
					"legendFormat": "{{cama_nombre}} (cama {{cama_id}})"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "none",
					"decimals": 2
				}
			},
			"gridPos": { "x": 16, "y": 41, "w": 8, "h": 8 }
		},
		{
			"type": "stat",
			"title": "Nodos conectados",
			"datasource": "Prometheus",
			"targets": [
				{
					"expr": "query_monitoring_nodos_conectados",
					"refId": "A"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "none",
					"decimals": 0
				}
			},
			"gridPos": { "x": 0, "y": 49, "w": 5, "h": 5 }
		},
		{
			"type": "stat",
			"title": "Nodos desconectados",
			"datasource": "Prometheus",
			"targets": [
				{
					"expr": "query_monitoring_nodos_desconectados",
					"refId": "A"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "none",
					"decimals": 0,
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{ "value": 0, "color": "green" },
							{ "value": 1, "color": "orange" },
							{ "value": 5, "color": "red" }
						]
					}
				}
			},
			"gridPos": { "x": 5, "y": 49, "w": 5, "h": 5 }
		},
		{
			"type": "stat",
			"title": "Lecturas inválidas",
			"datasource": "Prometheus",
			"targets": [
				{
					"expr": "query_monitoring_lecturas_invalidas",
					"refId": "A"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "none",
					"decimals": 0
				}
			},
			"gridPos": { "x": 10, "y": 49, "w": 5, "h": 5 }
		},
		{
			"type": "stat",
			"title": "Total nodos",
			"datasource": "Prometheus",
			"targets": [
				{
					"expr": "query_monitoring_total_nodos",
					"refId": "A"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "none",
					"decimals": 0
				}
			},
			"gridPos": { "x": 15, "y": 49, "w": 4, "h": 5 }
		},
		{
			"type": "stat",
			"title": "Total camas",
			"datasource": "Prometheus",
			"targets": [
				{
					"expr": "query_monitoring_total_camas",
					"refId": "A"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "none",
					"decimals": 0
				}
			},
			"gridPos": { "x": 19, "y": 49, "w": 5, "h": 5 }
		}
	],
	"templating": { "list": [] },
	"annotations": {
		"list": [
			{ "name": "Eventos", "type": "dashboard", "builtIn": 1, "enable": true }
		]
	},
	"time": { "from": "now-6h", "to": "now" }
}
