{
	"id": null,
	"uid": "vermicompost-iot-full",
	"title": "Vermicompost IoT - Monitoreo Completo",
	"timezone": "browser",
	"schemaVersion": 30,
	"version": 1,
	"refresh": "30s",
	"panels": [
		{
			"type": "row",
			"title": "Estado de Servicios",
			"gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
			"collapsed": false
		},
		{
			"type": "stat",
			"title": "Servicios UP",
			"datasource": "Prometheus",
			"targets": [
				{
					"expr": "count_over_time(up{job=~\"telemetry-ingestion-service|query-monitoring-service|digital-twin-integration-service|prometheus|grafana|node-exporter|postgres-exporter\"}[5m])",
					"legendFormat": "Servicios UP",
					"refId": "A"
				}
			],
			"fieldConfig": {
				"defaults": { "unit": "none", "decimals": 0 }
			},
			"gridPos": { "x": 0, "y": 1, "w": 6, "h": 5 }
		},
		{
			"type": "stat",
			"title": "Health API Grafana",
			"datasource": "Prometheus",
			"targets": [
				{
					"expr": "up{job=\"grafana\"}",
					"legendFormat": "Grafana",
					"refId": "A"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "none",
					"decimals": 0,
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{ "value": 0, "color": "red" },
							{ "value": 1, "color": "green" }
						]
					}
				}
			},
			"gridPos": { "x": 6, "y": 1, "w": 6, "h": 5 }
		},
		{
			"type": "row",
			"title": "Métricas IoT",
			"gridPos": { "x": 0, "y": 6, "w": 24, "h": 1 },
			"collapsed": false
		},
		{
			"type": "timeseries",
			"title": "Temperatura HW (°C)",
			"datasource": "Prometheus",
			"targets": [
				{
					"expr": "avg_over_time(node_hwmon_temp_celsius[5m])",
					"refId": "A",
					"legendFormat": "Temperatura (HW)"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "celsius",
					"decimals": 1,
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{ "color": "green", "value": 0 },
							{ "color": "orange", "value": 20 },
							{ "color": "red", "value": 35 }
						]
					}
				}
			},
			"gridPos": { "x": 0, "y": 7, "w": 12, "h": 8 }
		},
		{
			"type": "timeseries",
			"title": "Temperatura Zona (°C)",
			"datasource": "Prometheus",
			"targets": [
				{
					"expr": "avg_over_time(node_thermal_zone_temp[5m]) / 1000",
					"refId": "A",
					"legendFormat": "Temperatura zona"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "percent",
					"decimals": 1,
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{ "color": "red", "value": 0 },
							{ "color": "orange", "value": 30 },
							{ "color": "green", "value": 50 },
							{ "color": "orange", "value": 80 },
							{ "color": "red", "value": 100 }
						]
					}
				}
			},
			"gridPos": { "x": 12, "y": 7, "w": 12, "h": 8 }
		},
		{
			"type": "timeseries",
			"title": "Uso de disco raíz (%)",
			"datasource": "Prometheus",
			"targets": [
				{
					"expr": "100 * (node_filesystem_size_bytes{mountpoint='/',fstype!~'tmpfs|overlay'} - node_filesystem_free_bytes{mountpoint='/',fstype!~'tmpfs|overlay'}) / node_filesystem_size_bytes{mountpoint='/',fstype!~'tmpfs|overlay'}",
					"refId": "A",
					"legendFormat": "Uso disco /"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"decimals": 2,
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{ "color": "red", "value": 0 },
							{ "color": "orange", "value": 4 },
							{ "color": "green", "value": 6 },
							{ "color": "orange", "value": 8 },
							{ "color": "red", "value": 9 }
						]
					}
				}
			},
			"gridPos": { "x": 0, "y": 15, "w": 24, "h": 8 }
		},
		{
			"type": "row",
			"title": "Métricas de App",
			"gridPos": { "x": 0, "y": 23, "w": 24, "h": 1 },
			"collapsed": false
		},
		{
			"type": "timeseries",
			"title": "Latencia API Ingesta 95p (ms)",
			"datasource": "Prometheus",
			"targets": [
				{
					"expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{instance='telemetry-ingestion-service:8000'}[5m])) by (le)) * 1000",
					"refId": "A",
					"legendFormat": "Ingesta API p95"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "ms",
					"decimals": 1,
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{ "color": "green", "value": 0 },
							{ "color": "orange", "value": 200 },
							{ "color": "red", "value": 500 }
						]
					}
				}
			},
			"gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 }
		},
		{
			"type": "timeseries",
			"title": "Latencia API Query 95p (ms)",
			"datasource": "Prometheus",
			"targets": [
				{
					"expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{instance='query-monitoring-service:8000'}[5m])) by (le)) * 1000",
					"refId": "A",
					"legendFormat": "Query API p95"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "ms",
					"decimals": 1,
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{ "color": "green", "value": 0 },
							{ "color": "orange", "value": 200 },
							{ "color": "red", "value": 500 }
						]
					}
				}
			},
			"gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 }
		},
		{
			"type": "row",
			"title": "Métricas Infraestructura",
			"gridPos": { "x": 0, "y": 32, "w": 24, "h": 1 },
			"collapsed": false
		},
		{
			"type": "timeseries",
			"title": "CPU Node Exporter (%)",
			"datasource": "Prometheus",
			"targets": [
				{
					"expr": "100 - (avg by (instance)(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) *100)",
					"refId": "A",
					"legendFormat": "CPU %"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "percent",
					"decimals": 1,
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{ "color": "green", "value": 0 },
							{ "color": "orange", "value": 60 },
							{ "color": "red", "value": 85 }
						]
					}
				}
			},
			"gridPos": { "x": 0, "y": 33, "w": 12, "h": 8 }
		},
		{
			"type": "timeseries",
			"title": "Memoria disponible Node Exporter (GiB)",
			"datasource": "Prometheus",
			"targets": [
				{
					"expr": "node_memory_MemAvailable_bytes/1024/1024/1024",
					"refId": "A",
					"legendFormat": "Memoria disponible"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "gigabytes",
					"decimals": 2,
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{ "color": "red", "value": 0 },
							{ "color": "orange", "value": 0.5 },
							{ "color": "green", "value": 1 }
						]
					}
				}
			},
			"gridPos": { "x": 12, "y": 33, "w": 12, "h": 8 }
		},
		{
			"type": "timeseries",
			"title": "Conexiones Postgres (railway)",
			"datasource": "Prometheus",
			"targets": [
				{
					"expr": "sum(pg_stat_database_numbackends{datname=\"railway\"})",
					"refId": "A",
					"legendFormat": "Conexiones activas"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "none",
					"decimals": 0,
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{ "color": "green", "value": 0 },
							{ "color": "orange", "value": 50 },
							{ "color": "red", "value": 90 }
						]
					}
				}
			},
			"gridPos": { "x": 0, "y": 41, "w": 12, "h": 8 }
		},
		{
			"type": "timeseries",
			"title": "Locks Postgres",
			"datasource": "Prometheus",
			"targets": [
				{
					"expr": "pg_locks_count",
					"refId": "A",
					"legendFormat": "Locks activos"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "none",
					"decimals": 0,
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{ "color": "green", "value": 0 },
							{ "color": "orange", "value": 5 },
							{ "color": "red", "value": 20 }
						]
					}
				}
			},
			"gridPos": { "x": 12, "y": 41, "w": 12, "h": 8 }
		}
	],
	"templating": { "list": [] },
	"annotations": {
		"list": [
			{ "name": "Eventos", "type": "dashboard", "builtIn": 1, "enable": true }
		]
	},
	"time": { "from": "now-6h", "to": "now" }
}
